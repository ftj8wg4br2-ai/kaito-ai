{
  "name": "kaito-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "dev:api": "npm --workspace backend run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
